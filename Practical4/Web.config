<?xml version="1.0"?>
<configuration>
  <appSettings>
    <!-- Lets the validation controls work without the jQuery script mapping -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
